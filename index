<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Golconda — René Magritte</title>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,500;1,300&family=Noto+Serif+KR:wght@300;400&display=swap" rel="stylesheet">
<style>
:root{--bg:#15171d;--ink:#e9e4d8;--mute:#8d8f98;--gold:#b89b5e;--line:rgba(184,155,94,.35);
box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:light){:root:not([data-theme="dark"]){--bg:#15171d}}
html{height:100%;scroll-padding-top:env(safe-area-inset-top,0px)}
*{box-sizing:border-box}
body{margin:0;min-height:100%;background:radial-gradient(ellipse at 50% 38%,#232733 0%,var(--bg) 62%);color:var(--ink);
font-family:"Noto Serif KR","Cormorant Garamond",Georgia,serif;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:6vh 5vw;gap:3.2vh}
@media (hover:hover) and (pointer:fine){html,body,*{cursor:none!important}}
h1{margin:0;font-family:"Cormorant Garamond",Georgia,serif;font-weight:300;font-size:clamp(2.6rem,7vw,5.2rem);letter-spacing:.32em;padding-left:.32em;animation:rise 1.6s ease both}
.sub{margin:0;color:var(--mute);font-weight:300;font-size:.95rem;letter-spacing:.12em;animation:rise 1.6s .3s ease both}
.frame{position:relative;width:min(88vw,1040px);padding:clamp(10px,1.6vw,22px);background:#0d0e12;border:1px solid var(--line);
box-shadow:0 0 0 6px #0d0e12,0 0 0 7px var(--line),0 50px 120px -30px rgba(0,0,0,.8);animation:rise 1.8s .15s ease both}
.frame img{display:block;width:100%;height:auto}
.cap{display:flex;justify-content:space-between;gap:2rem;width:min(88vw,1040px);color:var(--mute);font-size:.85rem;font-weight:300;letter-spacing:.06em;line-height:1.8}
.cap em{font-family:"Cormorant Garamond",Georgia,serif;font-size:1.05rem;color:var(--gold)}
@keyframes rise{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:none}}
#man{position:fixed;left:0;top:0;width:38px;height:92px;pointer-events:none;z-index:99;opacity:0;transition:opacity .4s;will-change:transform;filter:drop-shadow(8px 10px 6px rgba(0,0,0,.35))}
@media (hover:none),(pointer:coarse){#man{display:none}}
@media (prefers-reduced-motion:reduce){*{animation:none!important}}
@media (max-width:640px){.cap{flex-direction:column;gap:.4rem}}
</style>
</head>
<body>
<h1>GOLCONDA</h1>
<p class="sub">르네 마그리트 · 1953</p>
<div class="frame"><img alt="마그리트의 골콩드: 붉은 지붕 건물 위 하늘에 중절모를 쓴 남자들이 떠 있다" src="data:image/jpeg;base64,"></div>
<div class="cap"><span><em>Golconda</em><br>캔버스에 유채, 81 × 100 cm</span><span style="text-align:right">하늘에서 내리는 비처럼,<br>같은 얼굴의 사람들이 떠 있다</span></div>

<svg id="man" viewBox="0 0 38 92" aria-hidden="true">
<ellipse cx="19" cy="6" rx="12" ry="1.8" fill="#12141a"/>
<path d="M10 6c0-5 4-7 9-7s9 2 9 7z" fill="#12141a"/>
<path d="M13 6h12v3H13z" fill="#12141a"/>
<ellipse cx="19" cy="14" rx="5.2" ry="6" fill="#c9a98f"/>
<path d="M13 12c1-3 3-4 6-4s5 1 6 4c-2-1-4-1.500-6-1.500S15 11 13 12z" fill="#12141a" opacity=".55"/>
<path d="M14 19h10l8 5c3 2 4 6 4 10v38h-8l-1 17H17l-1-17H8V34c0-4 1-8 4-10z" fill="#1d2536"/>
<path d="M16 20l3 14 3-14" fill="#e6e0d2"/>
<path d="M19 34v38M12 28l3 8M26 28l-3 8" stroke="#0e121b" stroke-width="1" fill="none"/>
<path d="M17 72h4v17h-4z" fill="#12141a" opacity=".5"/>
</svg>

<script>
(function(){
var m=document.getElementById('man');
if(!matchMedia('(hover:hover) and (pointer:fine)').matches)return;
var tx=0,ty=0,x=0,y=0,r=0,t0=performance.now();
addEventListener('mousemove',function(e){tx=e.clientX;ty=e.clientY;m.style.opacity=1});
document.addEventListener('mouseleave',function(){m.style.opacity=0});
function f(t){
var dx=tx-x;x+=dx*.16;y+=(ty-y)*.16;
r+=((dx*.35)-r)*.12; if(r>14)r=14; if(r<-14)r=-14;
var bob=Math.sin((t-t0)/700)*3;
m.style.transform='translate('+(x-19)+'px,'+(y-8+bob)+'px) rotate('+r+'deg)';
requestAnimationFrame(f)}
requestAnimationFrame(f);
})();
</script>
</body>
</html>
